{
  "name": "spectro-calib-studio",
  "version": "5.0.0",
  "description": "Ung dung offline huan luyen va kiem dinh mo hinh Calibration giua may quang pho Main va Sub",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.spectrocalibstudio",
    "productName": "Spectro Calib Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "build/icon_512.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon_1024.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon_512.png"
    }
  }
}
